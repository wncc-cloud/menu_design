rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    // Phase 1: businesses/* carries promotions (customer-facing ad space), the
    // first-load pop-up choice and system-section config, so only owner and
    // manager may write it. Staff keep menu/* (the live sold-out switch).
    function isOwnerOrManager() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'manager'];
    }

    // Public: anyone can read the live menu and business info
    match /menu/{docId} {
      // lastPublishedDraft is the draft exactly as last published (it keeps
      // hidden items and prices) — admins only, never public.
      allow read: if docId != 'lastPublishedDraft' || isAdmin();
      allow write: if isAdmin();
    }

    match /businesses/{docId} {
      allow read: if true;
      allow write: if isOwnerOrManager();
    }

    // Admins only: draft is never public
    match /menuDraft/{docId} {
      allow read, write: if isAdmin();
    }

    // Bug Logs: errors/warnings from the app. Customers are anonymous, so ANYONE
    // may create a log, but only in the exact shape the app writes (fixed keys,
    // size caps, server time, expiry within 8 days) and never edit one. Only
    // admins read them; owner/manager delete the expired ones (Admin > Bug logs).
    match /clientLogs/{logId} {
      allow get, list: if isAdmin();
      allow delete: if isOwnerOrManager();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly([
            'type', 'source', 'message', 'stackTrace', 'userId', 'userEmail',
            'userAgent', 'appUrl', 'createdAt', 'expireAt', 'schemaVersion',
            'errorCode', 'breadcrumbs'
          ])
        && request.resource.data.keys().hasAll([
            'type', 'source', 'message', 'userAgent', 'appUrl', 'createdAt',
            'expireAt', 'schemaVersion'
          ])
        && request.resource.data.type in ['ERROR', 'WARN']
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && (request.resource.data.get('stackTrace', null) == null
            || (request.resource.data.stackTrace is string
                && request.resource.data.stackTrace.size() <= 4000))
        && (request.resource.data.get('userId', null) == null
            || request.resource.data.userId == request.auth.uid)
        && (request.resource.data.get('userEmail', null) == null
            || (request.resource.data.userEmail is string
                && request.resource.data.userEmail.size() <= 200))
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500
        && request.resource.data.appUrl is string
        && request.resource.data.appUrl.size() <= 500
        && (!('errorCode' in request.resource.data)
            || (request.resource.data.errorCode is string
                && request.resource.data.errorCode.size() <= 100))
        && (!('breadcrumbs' in request.resource.data)
            || (request.resource.data.breadcrumbs is string
                && request.resource.data.breadcrumbs.size() <= 3000))
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(8, 'd');
    }

    // Admins can read their own document
    // Only owner can add or modify admin accounts
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isOwner();
    }
  }
}
